rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- 1. USER PROFILES (Strict Owner PII & Balance Protection) ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 40 &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('paypalEmail' in data) || (data.paypalEmail is string && data.paypalEmail.size() <= 160)) &&
             data.preferredPayoutCurrency in ['USD', 'EUR', 'MXN'] &&
             data.verifiedCreator is bool &&
             data.availableBalanceCents is int && data.availableBalanceCents >= 0 &&
             data.pendingBalanceCents is int && data.pendingBalanceCents >= 0 &&
             data.totalEarnedCents is int && data.totalEarnedCents >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'handle', 'preferredPayoutCurrency',
                         'verifiedCreator', 'availableBalanceCents', 'pendingBalanceCents',
                         'totalEarnedCents', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'handle', 'avatarUrl', 'paypalEmail',
                         'preferredPayoutCurrency', 'verifiedCreator', 'availableBalanceCents',
                         'pendingBalanceCents', 'totalEarnedCents', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().verifiedCreator == false &&
                       incoming().availableBalanceCents == 0 &&
                       incoming().pendingBalanceCents == 0 &&
                       incoming().totalEarnedCents == 0 &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().verifiedCreator == existing().verifiedCreator &&
                       incoming().availableBalanceCents == existing().availableBalanceCents &&
                       incoming().pendingBalanceCents == existing().pendingBalanceCents &&
                       incoming().totalEarnedCents == existing().totalEarnedCents &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'handle', 'avatarUrl', 'paypalEmail',
                         'preferredPayoutCurrency', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // --- 2. MEDIA POSTS (Creator Content & Monetization Config) ---
    function isValidMediaPost(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 600 &&
             data.mediaType in ['VIDEO', 'IMAGE'] &&
             data.visibility in ['PUBLIC', 'PRIVATE', 'SUBSCRIBERS'] &&
             data.monetizationType in ['FREE_ADS', 'PAY_PER_VIEW', 'LIVE_TIP'] &&
             data.priceCents is int && data.priceCents >= 0 && data.priceCents <= 100000 &&
             data.tags is list && data.tags.size() <= 10 &&
             (data.tags.size() == 0 || data.tags[0] is string) &&
             data.mediaUri is string && data.mediaUri.size() >= 1 && data.mediaUri.size() <= 800 &&
             data.editedExternally is bool &&
             (!('externalEditorName' in data) || (data.externalEditorName is string && data.externalEditorName.size() <= 80)) &&
             data.uploadState in ['QUEUED', 'COMPRESSING', 'UPLOADING', 'PUBLISHED'] &&
             data.uploadProgress is int && data.uploadProgress >= 0 && data.uploadProgress <= 100 &&
             data.viewsCount is int && data.viewsCount >= 0 &&
             data.earningsCents is int && data.earningsCents >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /media_posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) &&
                    (existing().userId == request.auth.uid || existing().visibility == 'PUBLIC');

      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || resource.data.visibility == 'PUBLIC');

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'creatorName', 'title', 'description', 'mediaType',
                         'visibility', 'monetizationType', 'priceCents', 'tags',
                         'mediaUri', 'editedExternally', 'uploadState', 'uploadProgress',
                         'viewsCount', 'earningsCents', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'creatorName', 'title', 'description', 'mediaType',
                         'visibility', 'monetizationType', 'priceCents', 'tags',
                         'mediaUri', 'editedExternally', 'externalEditorName',
                         'uploadState', 'uploadProgress', 'viewsCount', 'earningsCents',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().viewsCount == 0 &&
                       incoming().earningsCents == 0 &&
                       isValidMediaPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       existing().userId == request.auth.uid &&
                       isValidMediaPost(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().viewsCount == existing().viewsCount &&
                       incoming().earningsCents == existing().earningsCents &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'description', 'visibility', 'monetizationType',
                         'priceCents', 'tags', 'mediaUri', 'editedExternally',
                         'externalEditorName', 'uploadState', 'uploadProgress', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(postId) && existing().userId == request.auth.uid;
    }

    // --- 3. LIVE STREAMS & REALTIME CHAT ---
    function isValidLiveStream(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.rtmpIngestUrl is string && data.rtmpIngestUrl.size() >= 1 && data.rtmpIngestUrl.size() <= 400 &&
             data.playbackUrl is string && data.playbackUrl.size() >= 1 && data.playbackUrl.size() <= 400 &&
             data.status in ['PREPARING', 'LIVE', 'ENDED'] &&
             data.viewerCount is int && data.viewerCount >= 0 &&
             data.tipsEarnedCents is int && data.tipsEarnedCents >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLiveChatMessage(data, streamId) {
      return data.streamId == streamId &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
             data.tipCents is int && data.tipCents >= 0 && data.tipCents <= 50000 &&
             isValidTimestamp(data.createdAt);
    }

    match /live_streams/{streamId} {
      allow get: if isSignedIn() && isValidId(streamId) &&
                    (existing().userId == request.auth.uid || existing().status == 'LIVE');

      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || resource.data.status == 'LIVE');

      allow create: if isSignedIn() &&
                       isValidId(streamId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'creatorName', 'title', 'rtmpIngestUrl', 'playbackUrl',
                         'status', 'viewerCount', 'tipsEarnedCents', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'creatorName', 'title', 'rtmpIngestUrl', 'playbackUrl',
                         'status', 'viewerCount', 'tipsEarnedCents', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().tipsEarnedCents == 0 &&
                       incoming().viewerCount == 0 &&
                       isValidLiveStream(incoming());

      allow update: if isSignedIn() &&
                       isValidId(streamId) &&
                       existing().userId == request.auth.uid &&
                       existing().status != 'ENDED' &&
                       isValidLiveStream(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().tipsEarnedCents == existing().tipsEarnedCents &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'status', 'viewerCount', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(streamId) && existing().userId == request.auth.uid;

      match /chat_messages/{messageId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(messageId) &&
                      exists(/databases/$(database)/documents/live_streams/$(streamId));

        allow list: if isSignedIn() && isValidId(streamId) &&
                       resource.data.streamId == streamId;

        allow create: if isSignedIn() &&
                         isValidId(streamId) &&
                         isValidId(messageId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().tipCents == 0 &&
                         incoming().keys().hasAll([
                           'streamId', 'userId', 'senderName', 'message', 'tipCents', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'streamId', 'userId', 'senderName', 'message', 'tipCents', 'createdAt'
                         ]) &&
                         isValidLiveChatMessage(incoming(), streamId) &&
                         exists(/databases/$(database)/documents/live_streams/$(streamId));

        allow update, delete: if false;
      }
    }

    // --- 4. TRANSACTIONS LEDGER (Server-Only Writes, Owner Read-Only) ---
    match /transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // --- 5. PAYPAL PAYOUTS RECEIPTS (Server-Only Writes, Owner Read-Only) ---
    match /payouts/{payoutId} {
      allow get: if isSignedIn() && isValidId(payoutId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }
  }
}
